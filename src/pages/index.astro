---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ActivityHeatmap from '@/components/ActivityHeatmap.astro';
import { siteConfig } from '@/site.config';
import { sitePath } from '@/utils/paths';
import { formatDate } from '@/utils/content';
import { buildHeatmap, collectActivity, countWords, formatWords } from '@/lib/stats.mjs';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const novels = await getCollection('novels');
const chapters = await getCollection('chapters', ({ data }) => !data.draft);
const projects = await getCollection('projects');

const totalWords =
  posts.reduce((sum, post) => sum + countWords(post.body), 0) +
  chapters.reduce((sum, chapter) => sum + countWords(chapter.body), 0);

const stats = [
  { value: posts.length, label: '篇博客' },
  { value: novels.length, label: '部小说' },
  { value: chapters.length, label: '个章节' },
  { value: formatWords(totalWords), label: '总字数' },
  { value: projects.length, label: '个项目' },
];

const latestPosts = posts.slice(0, 10);

const events = [
  ...posts.map((post) => ({ date: post.data.date, kind: '博客', title: post.data.title, href: sitePath(`/blog/${post.data.slug}/`) })),
  ...chapters.map((chapter) => ({ date: chapter.data.published, kind: '章节', title: chapter.data.title, href: sitePath(`/novel/${chapter.data.novel}/${chapter.data.slug}/`) })),
  ...novels.map((novel) => ({ date: novel.data.updated, kind: '小说', title: novel.data.title, href: sitePath(`/novel/${novel.data.slug}/`) })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 8);

const activity = collectActivity([
  ...posts.map((post) => ({ date: post.data.date })),
  ...chapters.map((chapter) => ({ date: chapter.data.published })),
  ...novels.map((novel) => ({ date: novel.data.updated })),
]);
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">INDEPENDENT BUILDER · WRITER</p>
    <h1>写代码，也写<span>世界</span>。</h1>
    <p class="hero-copy">{siteConfig.description}</p>
    <div class="hero-actions">
      <a class="button primary" href={sitePath('/blog/')}>阅读博客</a>
      <a class="button" href={sitePath('/novel/')}>进入小说</a>
      <a class="text-link" href={siteConfig.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
    </div>
  </section>

  <section class="metric-strip" aria-label="站点统计">
    {stats.map((stat) => (
      <div><strong>{stat.value}</strong><span>{stat.label}</span></div>
    ))}
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><span class="eyebrow">ACTIVITY</span><h2>工作日志</h2></div>
      <span class="section-note">发布与更新的时间轨迹</span>
    </div>
    <div class="dashboard-grid">
      <ol class="log-list">
        {events.map((event) => (
          <li>
            <time datetime={event.date.toISOString()}>{formatDate(event.date)}</time>
            <span class="log-kind">{event.kind}</span>
            <a href={event.href}>{event.title}</a>
          </li>
        ))}
        {events.length === 0 && <li class="log-empty">还没有记录，发布第一篇文章后会出现在这里。</li>}
      </ol>
      <ActivityHeatmap
        month={buildHeatmap({ counts: activity, days: 30, columns: 30 })}
        recent={buildHeatmap({ counts: activity, days: 90, columns: 30 })}
        year={buildHeatmap({ counts: activity, days: 365, columns: 53 })}
      />
    </div>
  </section>

  <section class="section-block">
    <div class="section-heading">
      <div><span class="eyebrow">LATEST</span><h2>最新发布</h2></div>
      <a href={sitePath('/blog/')}>查看全部 →</a>
    </div>
    <ol class="post-list">
      {latestPosts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          <a class="post-title" href={sitePath(`/blog/${post.data.slug}/`)}>{post.data.title}</a>
          <span class="post-meta">{post.data.section} · {post.data.category}</span>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
