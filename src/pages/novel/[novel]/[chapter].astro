---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, slugify } from '@/utils/content';
import { sitePath } from '@/utils/paths';

export async function getStaticPaths() {
  const novels = await getCollection('novels');
  const chapters = (await getCollection('chapters', ({ data }) => import.meta.env.DEV || !data.draft))
    .sort((a, b) => a.data.chapter - b.data.chapter);

  return chapters.map((chapter) => {
    const novel = novels.find((item) => item.data.slug === chapter.data.novel);
    const siblings = chapters.filter((item) => item.data.novel === chapter.data.novel);
    const index = siblings.findIndex((item) => item.id === chapter.id);
    return {
      params: { novel: chapter.data.novel, chapter: chapter.data.slug },
      props: { chapter, novel, previous: siblings[index - 1], next: siblings[index + 1] },
    };
  });
}

interface Props {
  chapter: CollectionEntry<'chapters'>;
  novel?: CollectionEntry<'novels'>;
  previous?: CollectionEntry<'chapters'>;
  next?: CollectionEntry<'chapters'>;
}

const { chapter, novel, previous, next } = Astro.props;
const { Content, headings } = await render(chapter);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout
  title={`${chapter.data.title} · ${novel?.data.title ?? '小说'}`}
  description={chapter.data.description ?? chapter.data.title}
>
  <article class="reader" data-pagefind-body>
    <header class="reader-header">
      <a href={sitePath(`/novel/${chapter.data.novel}/`)}>{novel?.data.title ?? chapter.data.novel}</a>
      <span>{chapter.data.volume}</span>
      <h1 data-pagefind-meta="title">{chapter.data.title}</h1>
      <p>第 {chapter.data.chapter} 章 · {formatDate(chapter.data.published)}</p>
      {chapter.data.tags.length > 0 && (
        <div class="tag-row article-tags">
          {chapter.data.tags.map((tag) => (
            <a href={sitePath(`/tags/${encodeURIComponent(slugify(tag))}/`)}>#{tag}</a>
          ))}
        </div>
      )}
    </header>

    <div class="reader-toolbar" data-pagefind-ignore>
      <button type="button" data-font="smaller">A−</button>
      <button type="button" data-font="larger">A+</button>
      <button type="button" data-font="reset">默认</button>
    </div>

    {toc.length > 1 && (
      <details class="reader-toc" data-pagefind-ignore>
        <summary>本章目录</summary>
        <ol>
          {toc.map((heading) => (
            <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
          ))}
        </ol>
      </details>
    )}

    <div class="prose novel-prose" id="novel-content"><Content /></div>

    <nav class="chapter-nav" aria-label="章节导航" data-pagefind-ignore>
      {previous
        ? <a href={sitePath(`/novel/${chapter.data.novel}/${previous.data.slug}/`)}>← {previous.data.title}</a>
        : <span />}
      <a href={sitePath(`/novel/${chapter.data.novel}/`)}>目录</a>
      {next
        ? <a href={sitePath(`/novel/${chapter.data.novel}/${next.data.slug}/`)}>{next.data.title} →</a>
        : <span />}
    </nav>
  </article>

  <script is:inline>
    (() => {
      const content = document.querySelector('#novel-content');
      if (!content) return;
      const key = 'reader-font-size';
      let size = Number(localStorage.getItem(key) || 19);
      const apply = () => { content.style.fontSize = `${size}px`; };
      apply();
      document.querySelectorAll('[data-font]').forEach((button) => {
        button.addEventListener('click', () => {
          const action = button.dataset.font;
          if (action === 'larger') size = Math.min(26, size + 1);
          if (action === 'smaller') size = Math.max(15, size - 1);
          if (action === 'reset') size = 19;
          localStorage.setItem(key, String(size));
          apply();
        });
      });
    })();
  </script>
</BaseLayout>
