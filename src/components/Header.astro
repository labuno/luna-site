---
import { sitePath } from '@/utils/paths';
import { siteConfig } from '@/site.config';

const current = Astro.url.pathname;
const nav = [
  { href: sitePath('/blog/'), label: '博客', match: '/blog/' },
  { href: sitePath('/novel/'), label: '小说', match: '/novel/' },
  { href: sitePath('/projects/'), label: '项目', match: '/projects/' },
  { href: sitePath('/about/'), label: '关于', match: '/about/' },
];
---
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={sitePath('/')} aria-label="LunaFoundry 首页">
      <span class="brand-mark" aria-hidden="true">LF</span>
      <span>LunaFoundry</span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      {nav.map((item) => (
        <a class:list={[{ active: current.startsWith(item.href) }]} href={item.href}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        class="icon-button github-link"
        href={siteConfig.repo}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub 源代码仓库"
        title="GitHub 仓库"
      >
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.3-1.7-1.3-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.74 1.27 3.4.97.1-.76.4-1.27.73-1.56-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.3 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.26 5.69.42.36.78 1.07.78 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z"/></svg>
      </a>
      <a class="search-link" href={sitePath('/search/')} title="搜索（⌘/Ctrl + K）">
        <span aria-hidden="true">⌕</span>
        <span class="search-text">搜索</span>
        <kbd>⌘K</kbd>
      </a>
      <div class="theme-switch" role="group" aria-label="主题模式">
        <button type="button" data-theme-option="system" aria-pressed="false" title="跟随系统" aria-label="跟随系统主题">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="4" width="19" height="13" rx="2"></rect><path d="M8.5 20.5h7M12 17v3.5"></path></svg>
        </button>
        <button type="button" data-theme-option="light" aria-pressed="false" title="浅色" aria-label="浅色主题">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.8v2.4M12 18.8v2.4M2.8 12h2.4M18.8 12h2.4M5.5 5.5l1.7 1.7M16.8 16.8l1.7 1.7M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7"></path></svg>
        </button>
        <button type="button" data-theme-option="dark" aria-pressed="false" title="深色" aria-label="深色主题">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 14.2A8.6 8.6 0 1 1 9.8 3.6a7 7 0 0 0 10.6 10.6z"></path></svg>
        </button>
      </div>
    </div>
  </div>
</header>
