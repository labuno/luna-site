---
interface HeatmapDay {
  key: string;
  count: number;
  inRange: boolean;
  level: number;
}

interface HeatmapData {
  weeks: HeatmapDay[][];
  activeDays: number;
  total: number;
}

interface Props {
  month: HeatmapData;
  recent: HeatmapData;
  year: HeatmapData;
}

const { month, recent, year } = Astro.props;
const summary = (data: HeatmapData, label: string) => `${data.activeDays} 天有记录，${label}累计 ${data.total} 次`;

const views = [
  { id: 'month', label: '最近 30 天', data: month, summary: summary(month, '近 30 天') },
  { id: 'recent', label: '最近 90 天', data: recent, summary: summary(recent, '近 90 天') },
  { id: 'year', label: '全年轨迹', data: year, summary: summary(year, '今年') },
];
const defaultView = views[0];
---

<section class="heatmap-card" data-heatmap aria-label="写作轨迹">
  <div class="heatmap-head">
    <p class="heatmap-summary" data-heatmap-summary>{defaultView.summary}</p>
    <div class="heatmap-toggle" role="group" aria-label="轨迹范围">
      {views.map((view) => (
        <button
          type="button"
          data-heatmap-view={view.id}
          aria-pressed={view.id === defaultView.id ? 'true' : 'false'}
        >{view.label}</button>
      ))}
    </div>
  </div>

  {views.map((view) => (
    <div
      class="heatmap-grid"
      data-heatmap-grid={view.id}
      data-summary={view.summary}
      hidden={view.id !== defaultView.id}
    >
      {view.data.weeks.map((week) => (
        <div class="heatmap-week">
          {week.map((cell) => (
            <span
              class:list={['heat-cell', `level-${cell.level}`, !cell.inRange && 'is-out']}
              title={cell.inRange ? `${cell.key} · ${cell.count} 次` : undefined}
            />
          ))}
        </div>
      ))}
    </div>
  ))}

  <div class="heatmap-legend" aria-hidden="true">
    <span>少</span>
    {[0, 1, 2, 3, 4].map((level) => <span class:list={['heat-cell', `level-${level}`]} />)}
    <span>多</span>
  </div>
</section>

<script>
  import { setupHeatmap } from '@/scripts/heatmap.js';
  setupHeatmap();
</script>
