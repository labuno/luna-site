---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  title?: string;
  class?: string;
}

const { headings, title = '目录', class: className } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 1 && (
  <nav class:list={['toc', className]} aria-label={title} data-toc>
    <p class="toc-title">{title}</p>
    <ol>
      {items.map((heading) => (
        <li class:list={[`toc-depth-${heading.depth}`]}>
          <a href={`#${heading.slug}`}>{heading.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}
