# Copy to .env for local builds. Never commit real .env files.
# Public site URL (no trailing slash), used for canonical / RSS / sitemap.
SITE_URL=https://labuno.github.io
# Base path of the deployed site. Use / for a custom domain, /luna-site/ for GitHub Pages project site.
BASE_PATH=/luna-site/
# Optional: local private content repository (defaults to ../luna-ore)
# CONTENT_SOURCE_DIR=../luna-ore
