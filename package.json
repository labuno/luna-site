{
  "name": "lunafoundry-luna-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LunaFoundry static content site: Astro + Pagefind + GitHub Pages, built from a private content repository.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "dev:demo": "npm run content:demo && npm run dev",
    "check": "astro check",
    "content:sync": "node scripts/sync-content.mjs",
    "content:demo": "node scripts/sync-content.mjs ./examples",
    "validate:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "astro build && pagefind --site dist",
    "build:demo": "npm run content:demo && npm run validate:content && npm run build && npm run check:dist",
    "check:dist": "node scripts/check-links.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
